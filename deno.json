{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write --env-file=.env main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --env-file=.env main.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write tests/",
    "test:muse": "deno run --allow-net --allow-env --env-file=.env tests/muse_smoke.ts",
    "check": "deno check main.ts tests/ && deno lint && deno fmt --check"
  },
  "unstable": ["kv"],
  "fmt": {
    "lineWidth": 120,
    "exclude": ["public/"]
  },
  "lint": {
    "exclude": ["public/"]
  }
}
