# Copy to .env and fill in. .env is git-ignored.

# Meta Model API (Muse Spark) -- plays the wolf. Get a key at https://dev.meta.ai
# Leave it empty and the wolf falls back to scripted lines.
MUSE_API_KEY=
# MUSE_BASE_URL=https://api.meta.ai/v1
# MUSE_MODEL=muse-spark-1.3
# MUSE_REASONING_EFFORT=low

# SerpApi (https://serpapi.com/manage-api-key) -- lets the Muse wolf look things up. Optional:
# without it the wolf still keeps its match memory, it just doesn't search.
SERPAPI_API_KEY=
# MUSE_RESEARCH=off          # no research and no match memory: the original wolf
# MUSE_SEARCH_BUDGET=6       # paid searches per tale, 3 of them before it starts; cache hits are free
# SERPAPI_TIMEOUT_MS=4000

# Shared Deno KV database "global-kv" on Deno Deploy.
# On Deno Deploy, assign global-kv to the app and leave these blank.
# For local runs against the real database, fill both in:
#   database ID: Deno Deploy > Databases > global-kv
#   token:       Deno Deploy > Account settings > Access tokens
# With both blank, local runs use .data/global-kv.sqlite3 instead.
DENO_KV_DATABASE_ID=
DENO_KV_ACCESS_TOKEN=
# KV_PATH=  # or any path / KV Connect URL, passed straight to Deno.openKv

# Optional tuning
# PORT=8000
# ANSWER_SECONDS=60
# DISCUSS_SECONDS=75
# VOTE_SECONDS=45
# WOLF_PACE=1    # multiplies the wolf's delays; 0.2 makes it quick for testing
