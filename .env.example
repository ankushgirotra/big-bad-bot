# Copy to .env and fill in. .env is git-ignored: never commit real keys.
# On Deno Deploy, set the same variables in the app's Settings > Environment variables.

# Claude plays the wolf. Key from platform.claude.com.
ANTHROPIC_API_KEY=
# Meta's Muse writes each tale's questions (Claude takes over if it fails). Key from dev.meta.ai.
MUSE_API_KEY=
# SerpApi, from serpapi.com. Nothing calls it yet.
SERPAPI_API_KEY=

# Shared Deno KV database "global-kv" (optional). Leave blank to use .data/global-kv.sqlite3 locally,
# or the database assigned to the app on Deno Deploy.
DENO_KV_DATABASE_ID=
DENO_KV_ACCESS_TOKEN=

# WOLF_MODEL=haiku   # haiku (default), sonnet or opus
